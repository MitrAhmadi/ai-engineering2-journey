OPENAI_API_KEY=sk-...

# The model that does the talking.
# MODEL=gpt-4o

# Bidding for the floor in the panel: one call per practitioner per round,
# so it wants to be cheap.
# BID_MODEL=gpt-4o-mini

# Web search runs on the Responses API's hosted web_search tool — same key,
# no second provider to sign up for.
# SEARCH_MODEL=gpt-4o-mini

# Which lens the 1:1 mentor starts in: cbt | istdp | analytical | behavioral
# MODALITY=cbt

# Who is in the room. Any subset, comma separated.
# PANEL=cbt,istdp,analytical,behavioral
